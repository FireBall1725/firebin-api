{
  "Exclude": [
    "^vendor/",
    "^node_modules/",
    "^\\.build/",
    "^dist/",
    "^docs/swagger\\.",
    "^docs/docs\\.go$",
    "Package\\.resolved$",
    "package-lock\\.json$",
    "\\.generated\\.swift$",
    "\\.min\\.(js|css)$",
    "\\.(png|jpg|jpeg|gif|ico|icns|pdf|woff2?|ttf|dmg|zip)$"
  ],
  "Verbose": false,
  "IgnoreDefaults": false,
  "SpacesAfterTabs": false,
  "Disable": {
    "EndOfLine": false,
    "Indentation": false,
    "InsertFinalNewline": false,
    "TrimTrailingWhitespace": false,
    "MaxLineLength": true
  }
}
